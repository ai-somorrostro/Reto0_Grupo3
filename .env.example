# Entorno local (Fedora, fuera de Docker)
INFLUX_URL=http://localhost:8086
INFLUX_ORG=red_electrica
INFLUX_BUCKET=ree_analisis
INFLUX_WRITE_TOKEN=replace-with-write-token
INFLUX_READ_TOKEN=replace-with-read-token
INFLUX_MEASUREMENT=ree_analisis
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=change-me-in-local-env

# URL del Grafana accesible desde el host para el MCP oficial.
GRAFANA_URL=http://localhost:3000
GRAFANA_MCP_TOKEN=replace-with-grafana-service-account-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-local-env

# Usuarios de prueba/departamentos para el bootstrap de Grafana.
# Formato por usuario: login|email|password|equipo|dashboard-inicial
# Separar usuarios con punto y coma. No subir el .env real al repositorio.
# Equipos válidos: Direccion, Analisis, IT
# Ejemplo:
# GRAFANA_BOOTSTRAP_USERS=ceo|ceo@example.local|cambia-esta-clave|Direccion|ree-transicion-energetica;analista1|analista1@example.local|cambia-esta-clave|Analisis|ree-comunidades;it1|it1@example.local|cambia-esta-clave|IT|ree-transicion-energetica
GRAFANA_BOOTSTRAP_USERS=
GRAFANA_ORG_ID=1
# UIDs que el equipo Analisis puede visualizar. Separar con comas.
GRAFANA_ANALYSIS_DASHBOARD_UIDS=ree-comunidades

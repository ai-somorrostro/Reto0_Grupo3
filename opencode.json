{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "grafana": {
      "type": "remote",
      "url": "http://localhost:8000/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 10000,
      "headers": {
        "Authorization": "Bearer {env:MCP_GRAFANA_TOKEN}"
      }
    }
  }
}
